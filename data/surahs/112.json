{"number":112,"name":"الإِخۡلَاصِ","englishName":"Al-Ikhlaas","englishNameTranslation":"Sincerity","revelationType":"Meccan","ayahCount":4,"bismillah":true,"ayahs":[{"n":1,"g":6222,"text":"قُلْ هُوَ ٱللَّهُ أَحَدٌ","en":"Say, \"He is Allah, [who is] One,","ur":"کہو کہ وہ (ذات پاک جس کا نام) الله (ہے) ایک ہے","juz":30,"ip":"قُلۡ هُوَ اللّٰهُ اَحَدٌ​ ۚ‏"},{"n":2,"g":6223,"text":"ٱللَّهُ ٱلصَّمَدُ","en":"Allah, the Eternal Refuge.","ur":"معبود برحق جو بےنیاز ہے","juz":30,"ip":"اَللّٰهُ الصَّمَدُ​ ۚ‏"},{"n":3,"g":6224,"text":"لَمْ يَلِدْ وَلَمْ يُولَدْ","en":"He neither begets nor is born,","ur":"نہ کسی کا باپ ہے اور نہ کسی کا بیٹا","juz":30,"ip":"لَمۡ يَلِدۡ   ۙ وَلَمۡ يُوۡلَدۡ ۙ‏"},{"n":4,"g":6225,"text":"وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ","en":"Nor is there to Him any equivalent.\"","ur":"اور کوئی اس کا ہمسر نہیں","juz":30,"ip":"وَلَمۡ يَكُنۡ لَّهٗ كُفُوًا اَحَدٌ‏"}]}